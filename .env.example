# Database Connection String
DATABASE_URL=postgresql://postgres:password@localhost:5432/travelrescue_db

# Server Configuration
PORT=5001
NODE_ENV=development

# Frontend CORS URL
FRONTEND_URL=http://localhost:5173

# Transport Providers Configuration (mock | real)
TRAIN_PROVIDER=mock
BUS_PROVIDER=mock
FLIGHT_PROVIDER=mock
TRANSPORT_FALLBACK_TO_MOCK=true

# Real Provider API Keys & Base URLs (Optional - left blank in mock mode)
TRAIN_API_KEY=
TRAIN_API_URL=https://railway-live-enquiry.p.rapidapi.com
BUS_API_KEY=
BUS_API_URL=https://api.aopay.in/v1/bus
FLIGHT_API_KEY=
FLIGHT_API_URL=https://api.aviationstack.com/v1
